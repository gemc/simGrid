FROM almalinux:9.4 
LABEL maintainer="Maurizio Ungaro <ungaro@jlab.org>"

# run shell instead of sh
SHELL ["/bin/bash", "-c"]

ENV AUTOBUILD=1

COPY localSetupBase.sh /etc/profile.d/localSetup.sh

# JLab certificate
ADD https://pki.jlab.org/JLabCA.crt /etc/pki/ca-trust/source/anchors/JLabCA.crt
RUN update-ca-trust 

# alma specific:
# crb: for mysql-devel
# synergy: root, scons, vnc
RUN    dnf install -y  'dnf-command(config-manager)' \
    && dnf config-manager --set-enabled crb \
    && dnf install -y almalinux-release-synergy 


# pelican RPM repository
RUN rpm -i https://repo.osg-htc.org/osg/24-main/osg-24-main-el9-release-latest.rpm 

RUN echo "module use /cvmfs/jlab.opensciencegrid.org/geant4/modules" >> /etc/profile.d/localSetup.sh

RUN dnf install -y --allowerasing  mariadb-devel python3-numpy cc binutils lsof bzip2 wget curl nano bash tcsh zsh hostname environment-modules rsync patch which pelican pelican-osdf-compat pelican-server htgettoken openssh-clients  \
 && dnf -y update \
 && dnf -y check-update \
 && dnf clean packages \
 && dnf clean all \
 && rm -rf /var/cache/dnf 



